direction: right

# Tables
{{- range .Tables }}
{{tableKey .Name}}: {
  shape: "sql_table"
{{- range .Columns }}
  {{quote .Name}}: {{quote .Definition}}{{if .IsPrimary}} { constraint: [primary_key] }{{end}}
{{- end }}
}
{{- end }}

# References
{{- range .References }}
{{tableKey .Source.Table}}.{{quote .Source.Column}} -> {{tableKey .Target.Table}}.{{quote .Target.Column}}{{if .Name}}: {{quote .Name}}{{end}}
{{- end }}
